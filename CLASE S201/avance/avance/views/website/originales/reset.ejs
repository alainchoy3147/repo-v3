<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Recuperar Contraseña</title>
  <link rel="stylesheet" href="assets/css/login.css">
</head>
<body>
  <div class="form">
    <!-- LOGO -->
    <div class="center">
      <img src="assets/img/ulimaLogo.png" width="203" height="50.17" alt="Logo ULima">
    </div>
    <br>

    <!-- TITULO -->
    <h3 class="center">RECUPERAR CONTRASEÑA</h3>
    <p class="center">
      Ingresa el correo asociado a tu cuenta y te enviaremos un enlace para restablecer tu contraseña.
    </p>

    <!-- INPUT CORREO -->
    <label for="txtEmail">Correo electrónico</label>
    <br>
    <input class="input" type="email" name="email" id="txtEmail" placeholder="Ingrese su correo">
    <br><br>

    <!-- BOTON -->
    <button class="btn">ENVIAR ENLACE</button>
    <br><br>

    <!-- VOLVER AL LOGIN -->
    <div class="center">
      <a href="login.html">Volver a iniciar sesión</a>
    </div>

    <br>
    <small>© 1997-2026 Blackboard Inc. Todos los derechos reservados.</small>
  </div>
</body>
</html>