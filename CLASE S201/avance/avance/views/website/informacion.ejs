<!-- views/website/informacion.ejs -->
<% layout("layouts/website") %>

<!-- =========================================================
     ENCABEZADO
========================================================= -->

<section
  class="text-white"
  style="
    background:
      linear-gradient(
        90deg,
        rgba(0,0,0,.90),
        rgba(0,0,0,.55),
        rgba(0,0,0,.25)
      ),
      url('/assets/img/slider-3.jpg')
      center/cover;
  ">

  <div class="container py-5">

    <div class="row py-4">

      <div class="col-lg-7">

        <span class="badge bg-success mb-3 px-3 py-2">
          CÓMO FUNCIONA
        </span>

        <h1 class="display-5 fw-bold mb-3">
          Consigue tu práctica en
          <span class="text-success">4 pasos</span>
        </h1>

        <p class="lead text-light mb-0">
          Así de simple es encontrar tu primera experiencia
          laboral con PrácticaLima.
        </p>

      </div>

    </div>

  </div>

</section>


<!-- =========================================================
     PASOS PARA ESTUDIANTES
========================================================= -->

<section class="py-5">

  <div class="container">

    <div class="text-center mb-5">

      <span class="text-success fw-bold text-uppercase">
        Para estudiantes
      </span>

      <h2 class="fw-bold mt-2">
        Tu camino hacia la práctica
      </h2>

    </div>


    <%
      const steps = [
        { numero: 1, titulo: 'Crea tu cuenta', texto: 'Regístrate gratis con tu correo universitario.', icono: 'fa-user-plus' },
        { numero: 2, titulo: 'Completa tu perfil', texto: 'Agrega tu carrera, ciclo, habilidades y sube tu CV.', icono: 'fa-id-card' },
        { numero: 3, titulo: 'Busca y postula', texto: 'Filtra las ofertas y postula con un solo clic.', icono: 'fa-magnifying-glass' },
        { numero: 4, titulo: 'Recibe respuesta', texto: 'Sigue el estado de tus postulaciones y prepárate para la entrevista.', icono: 'fa-envelope-open-text' }
      ]
    %>

    <div class="row g-4">

      <% steps.forEach(step => { %>

        <div class="col-12 col-md-6 col-lg-3">

          <div class="card border-0 shadow-sm h-100">

            <div class="card-body text-center p-4">

              <div
                class="bg-success bg-opacity-10
                       text-success rounded-circle
                       d-inline-flex align-items-center
                       justify-content-center mb-3"
                style="width:70px;height:70px;">

                <i class="fa-solid <%= step.icono %> fs-2"></i>

              </div>

              <span class="badge bg-success d-block mx-auto mb-2" style="width:fit-content;">
                PASO <%= step.numero %>
              </span>

              <h5 class="fw-bold">
                <%= step.titulo %>
              </h5>

              <p class="text-muted mb-0">
                <%= step.texto %>
              </p>

            </div>

          </div>

        </div>

      <% }) %>

    </div>

  </div>

</section>


<!-- =========================================================
     PARA EMPRESAS
========================================================= -->

<section class="bg-dark text-white py-5">

  <div class="container">

    <div class="row align-items-center g-5">

      <div class="col-lg-6">

        <span class="badge bg-success mb-3">
          PARA EMPRESAS
        </span>

        <h2 class="display-6 fw-bold mb-4">
          Encuentra al practicante ideal.
        </h2>

        <p class="text-secondary lead">
          Publica tus convocatorias, recibe postulaciones de
          estudiantes filtrados por carrera y gestiona todo
          el proceso desde un solo lugar.
        </p>

        <a
          href="/login"
          class="btn btn-success mt-3">

          Publicar una oferta

        </a>

      </div>


      <div class="col-lg-6">

        <div class="row g-3">

          <div class="col-6">

            <div class="card bg-secondary bg-opacity-10
                        border-secondary h-100">

              <div class="card-body p-4">

                <i class="fa-solid fa-bullhorn text-success fs-1"></i>

                <h5 class="mt-3 text-white">
                  Publica
                </h5>

                <p class="text-secondary small mb-0">
                  Crea tu convocatoria en minutos.
                </p>

              </div>

            </div>

          </div>


          <div class="col-6">

            <div class="card bg-secondary bg-opacity-10
                        border-secondary h-100">

              <div class="card-body p-4">

                <i class="fa-solid fa-inbox text-success fs-1"></i>

                <h5 class="mt-3 text-white">
                  Recibe
                </h5>

                <p class="text-secondary small mb-0">
                  Revisa los CV de los postulantes.
                </p>

              </div>

            </div>

          </div>


          <div class="col-6">

            <div class="card bg-secondary bg-opacity-10
                        border-secondary h-100">

              <div class="card-body p-4">

                <i class="fa-solid fa-list-check text-success fs-1"></i>

                <h5 class="mt-3 text-white">
                  Selecciona
                </h5>

                <p class="text-secondary small mb-0">
                  Marca a los candidatos que avanzan.
                </p>

              </div>

            </div>

          </div>


          <div class="col-6">

            <div class="card bg-secondary bg-opacity-10
                        border-secondary h-100">

              <div class="card-body p-4">

                <i class="fa-solid fa-handshake text-success fs-1"></i>

                <h5 class="mt-3 text-white">
                  Contrata
                </h5>

                <p class="text-secondary small mb-0">
                  Suma talento joven a tu equipo.
                </p>

              </div>

            </div>

          </div>

        </div>

      </div>

    </div>

  </div>

</section>


<!-- =========================================================
     PREGUNTAS FRECUENTES
========================================================= -->

<section class="bg-light py-5">

  <div class="container">

    <div class="text-center mb-5">

      <span class="text-success fw-bold text-uppercase">
        Resolvemos tus dudas
      </span>

      <h2 class="fw-bold mt-2">
        Preguntas frecuentes
      </h2>

    </div>


    <div class="row justify-content-center">

      <div class="col-lg-8">

        <div class="accordion shadow-sm" id="faqAccordion">

          <div class="accordion-item border-0">

            <h2 class="accordion-header">

              <button
                class="accordion-button fw-semibold"
                type="button"
                data-bs-toggle="collapse"
                data-bs-target="#faq1"
                aria-expanded="true"
                aria-controls="faq1">

                ¿Tiene algún costo usar PrácticaLima?

              </button>

            </h2>

            <div
              id="faq1"
              class="accordion-collapse collapse show"
              data-bs-parent="#faqAccordion">

              <div class="accordion-body text-muted">
                No. Crear tu cuenta y postular a las ofertas es
                completamente gratis para estudiantes.
              </div>

            </div>

          </div>


          <div class="accordion-item border-0">

            <h2 class="accordion-header">

              <button
                class="accordion-button collapsed fw-semibold"
                type="button"
                data-bs-toggle="collapse"
                data-bs-target="#faq2"
                aria-expanded="false"
                aria-controls="faq2">

                ¿Cuál es la diferencia entre práctica preprofesional y profesional?

              </button>

            </h2>

            <div
              id="faq2"
              class="accordion-collapse collapse"
              data-bs-parent="#faqAccordion">

              <div class="accordion-body text-muted">
                Las prácticas preprofesionales son para estudiantes que
                aún cursan la carrera. Las profesionales son para
                egresados, dentro de los 12 meses siguientes a
                terminar sus estudios.
              </div>

            </div>

          </div>


          <div class="accordion-item border-0">

            <h2 class="accordion-header">

              <button
                class="accordion-button collapsed fw-semibold"
                type="button"
                data-bs-toggle="collapse"
                data-bs-target="#faq3"
                aria-expanded="false"
                aria-controls="faq3">

                ¿Desde qué ciclo puedo postular?

              </button>

            </h2>

            <div
              id="faq3"
              class="accordion-collapse collapse"
              data-bs-parent="#faqAccordion">

              <div class="accordion-body text-muted">
                Depende de cada oferta. En cada convocatoria verás
                el ciclo mínimo que pide la empresa.
              </div>

            </div>

          </div>


          <div class="accordion-item border-0">

            <h2 class="accordion-header">

              <button
                class="accordion-button collapsed fw-semibold"
                type="button"
                data-bs-toggle="collapse"
                data-bs-target="#faq4"
                aria-expanded="false"
                aria-controls="faq4">

                ¿Cómo sé si una empresa es confiable?

              </button>

            </h2>

            <div
              id="faq4"
              class="accordion-collapse collapse"
              data-bs-parent="#faqAccordion">

              <div class="accordion-body text-muted">
                Todas las empresas pasan por una verificación antes
                de poder publicar sus convocatorias.
              </div>

            </div>

          </div>

        </div>

      </div>

    </div>

  </div>

</section>


<!-- =========================================================
     CTA FINAL
========================================================= -->

<section class="py-5">

  <div class="container">

    <div
      class="bg-success rounded-4 p-5 text-center text-white">

      <i class="fa-solid fa-rocket fs-1"></i>

      <h2 class="fw-bold mt-3">
        ¿Todo claro? ¡Empieza ahora!
      </h2>

      <p class="lead mb-4">
        Crea tu cuenta y postula a tu primera práctica hoy.
      </p>

      <a
        href="/login"
        class="btn btn-light btn-lg px-5">

        <i class="fa-solid fa-user-plus me-2"></i>
        Crear cuenta

      </a>

    </div>

  </div>

</section>
