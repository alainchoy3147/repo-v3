<!-- views/website/home.ejs -->
<% layout("layouts/website") %>

<section class="bg-dark text-white">

  <div id="heroCarousel"
       class="carousel slide carousel-fade"
       data-bs-ride="carousel">

    <!-- Indicadores -->
    <div class="carousel-indicators">

      <button
        type="button"
        data-bs-target="#heroCarousel"
        data-bs-slide-to="0"
        class="active"
        aria-current="true"
        aria-label="Slide 1">
      </button>

      <button
        type="button"
        data-bs-target="#heroCarousel"
        data-bs-slide-to="1"
        aria-label="Slide 2">
      </button>

      <button
        type="button"
        data-bs-target="#heroCarousel"
        data-bs-slide-to="2"
        aria-label="Slide 3">
      </button>

    </div>


    <!-- Slides -->
    <div class="carousel-inner">


      <!-- SLIDE 1 -->
      <div class="carousel-item active">

        <div
          class="container-fluid"
          style="
            min-height: 600px;
            background:
              linear-gradient(
                90deg,
                rgba(0,0,0,.90),
                rgba(0,0,0,.55),
                rgba(0,0,0,.25)
              ),
              url('/assets/img/slider-1.jpg')
              center/cover;
          ">

          <div
            class="container d-flex align-items-center"
            style="min-height: 600px;">

            <div class="row w-100">

              <div class="col-lg-7">

                <span class="badge bg-success mb-3 px-3 py-2">
                  BOLSA DE PRÁCTICAS UNIVERSITARIAS
                </span>

                <h1 class="display-3 fw-bold mb-4">
                  Tu primera experiencia empieza en
                  <span class="text-success">
                    PrácticaLima
                  </span>
                </h1>

                <p class="lead text-light mb-4">
                  Encuentra prácticas preprofesionales y profesionales
                  en las mejores empresas de Lima, pensadas para
                  estudiantes universitarios como tú.
                </p>

                <div class="d-flex flex-wrap gap-2">

                  <a
                    href="/convocatorias"
                    class="btn btn-success btn-lg px-4">

                    <i class="fa-solid fa-briefcase me-2"></i>
                    Ver ofertas

                  </a>

                  <a
                    href="/informacion"
                    class="btn btn-outline-light btn-lg px-4">

                    Cómo funciona

                  </a>

                </div>

              </div>

            </div>

          </div>

        </div>

      </div>


      <!-- SLIDE 2 -->
      <div class="carousel-item">

        <div
          class="container-fluid"
          style="
            min-height: 600px;
            background:
              linear-gradient(
                90deg,
                rgba(0,0,0,.90),
                rgba(0,0,0,.55),
                rgba(0,0,0,.25)
              ),
              url('/assets/img/slider-2.jpg')
              center/cover;
          ">

          <div
            class="container d-flex align-items-center"
            style="min-height: 600px;">

            <div class="row w-100">

              <div class="col-lg-7">

                <span class="badge bg-success mb-3 px-3 py-2">
                  EMPRESAS VERIFICADAS
                </span>

                <h2 class="display-4 fw-bold mb-4">
                  Postula a empresas
                  <span class="text-success">
                    que te buscan
                  </span>
                </h2>

                <p class="lead mb-4">
                  Bancos, consultoras, startups y más publican
                  sus convocatorias para practicantes cada semana.
                </p>

                <a
                  href="/empresas"
                  class="btn btn-success btn-lg px-4">

                  <i class="fa-solid fa-building me-2"></i>
                  Ver empresas

                </a>

              </div>

            </div>

          </div>

        </div>

      </div>


      <!-- SLIDE 3 -->
      <div class="carousel-item">

        <div
          class="container-fluid"
          style="
            min-height: 600px;
            background:
              linear-gradient(
                90deg,
                rgba(0,0,0,.90),
                rgba(0,0,0,.55),
                rgba(0,0,0,.25)
              ),
              url('/assets/img/slider-3.jpg')
              center/cover;
          ">

          <div
            class="container d-flex align-items-center"
            style="min-height: 600px;">

            <div class="row w-100">

              <div class="col-lg-7">

                <span class="badge bg-success mb-3 px-3 py-2">
                  POSTULA EN MINUTOS
                </span>

                <h2 class="display-4 fw-bold mb-4">
                  Crea tu perfil y
                  <span class="text-success">
                    postula gratis
                  </span>
                </h2>

                <p class="lead mb-4">
                  Sube tu CV una sola vez y postula a todas
                  las ofertas con un solo clic.
                </p>

                <a
                  href="/login"
                  class="btn btn-success btn-lg px-4">

                  <i class="fa-solid fa-user-plus me-2"></i>
                  Crear cuenta

                </a>

              </div>

            </div>

          </div>

        </div>

      </div>

    </div>


    <!-- Controles -->
    <button
      class="carousel-control-prev"
      type="button"
      data-bs-target="#heroCarousel"
      data-bs-slide="prev">

      <span class="carousel-control-prev-icon"></span>

      <span class="visually-hidden">
        Anterior
      </span>

    </button>

    <button
      class="carousel-control-next"
      type="button"
      data-bs-target="#heroCarousel"
      data-bs-slide="next">

      <span class="carousel-control-next-icon"></span>

      <span class="visually-hidden">
        Siguiente
      </span>

    </button>

  </div>

</section>


<!-- =========================================================
     BUSCADOR RÁPIDO
========================================================= -->

<section class="bg-light py-5">

  <div class="container">

    <div class="text-center mb-4">

      <span class="text-success fw-bold text-uppercase">
        Busca tu práctica
      </span>

      <h2 class="fw-bold mt-2">
        Encuentra la oferta ideal para ti
      </h2>

      <p class="text-muted">
        Filtra por puesto, carrera, distrito y modalidad.
      </p>

    </div>


    <div class="card border-0 shadow-sm">

      <div class="card-body p-4">

        <form
          action="/convocatorias"
          method="GET">

          <div class="row g-3">

            <!-- Puesto -->
            <div class="col-12 col-lg-4">

              <label class="form-label fw-semibold">
                Puesto o palabra clave
              </label>

              <div class="input-group">

                <span class="input-group-text bg-white">
                  <i class="fa-solid fa-magnifying-glass"></i>
                </span>

                <input
                  type="text"
                  class="form-control"
                  name="search"
                  placeholder="Ej. Marketing, Analista, Desarrollador...">

              </div>

            </div>


            <!-- Carrera -->
            <div class="col-12 col-md-4 col-lg-2">

              <label class="form-label fw-semibold">
                Carrera
              </label>

              <select
                name="carrera"
                class="form-select">

                <option value="">Todas</option>
                <option value="ingenieria-sistemas">Ing. de Sistemas</option>
                <option value="ingenieria-industrial">Ing. Industrial</option>
                <option value="administracion">Administración</option>
                <option value="economia">Economía</option>
                <option value="contabilidad">Contabilidad</option>
                <option value="derecho">Derecho</option>
                <option value="comunicaciones">Comunicaciones</option>
                <option value="psicologia">Psicología</option>

              </select>

            </div>


            <!-- Distrito -->
            <div class="col-12 col-md-4 col-lg-2">

              <label class="form-label fw-semibold">
                Distrito
              </label>

              <select
                name="distrito"
                class="form-select">

                <option value="">Todos</option>
                <option value="miraflores">Miraflores</option>
                <option value="san-isidro">San Isidro</option>
                <option value="surco">Santiago de Surco</option>
                <option value="la-molina">La Molina</option>
                <option value="san-borja">San Borja</option>
                <option value="cercado">Cercado de Lima</option>

              </select>

            </div>


            <!-- Modalidad -->
            <div class="col-12 col-md-4 col-lg-2">

              <label class="form-label fw-semibold">
                Modalidad
              </label>

              <select
                name="modalidad"
                class="form-select">

                <option value="">Todas</option>
                <option value="presencial">Presencial</option>
                <option value="hibrido">Híbrido</option>
                <option value="remoto">Remoto</option>

              </select>

            </div>


            <!-- Botón -->
            <div class="col-12 col-lg-2 d-flex align-items-end">

              <button
                type="submit"
                class="btn btn-success w-100">

                <i class="fa-solid fa-magnifying-glass me-2"></i>
                Buscar

              </button>

            </div>

          </div>

        </form>

      </div>

    </div>

  </div>

</section>


<!-- =========================================================
     ESTADÍSTICAS GENERALES
========================================================= -->

<section class="py-5">

  <div class="container">

    <div class="text-center mb-5">

      <span class="text-success fw-bold">
        PRÁCTICALIMA EN NÚMEROS
      </span>

      <h2 class="fw-bold mt-2">
        Una comunidad que crece cada día
      </h2>

    </div>


    <div class="row g-4">


      <!-- Ofertas -->
      <div class="col-6 col-lg-3">

        <div class="card border-0 shadow-sm h-100">

          <div class="card-body text-center p-4">

            <div
              class="bg-success bg-opacity-10
                     text-success rounded-circle
                     d-inline-flex align-items-center
                     justify-content-center mb-3"
              style="width:70px;height:70px;">

              <i class="fa-solid fa-briefcase fs-2"></i>

            </div>

            <h3 class="fw-bold mb-1">
              <%= typeof offerCount !== 'undefined' ? offerCount : '1.2K+' %>
            </h3>

            <p class="text-muted mb-0">
              Ofertas activas
            </p>

          </div>

        </div>

      </div>


      <!-- Empresas -->
      <div class="col-6 col-lg-3">

        <div class="card border-0 shadow-sm h-100">

          <div class="card-body text-center p-4">

            <div
              class="bg-primary bg-opacity-10
                     text-primary rounded-circle
                     d-inline-flex align-items-center
                     justify-content-center mb-3"
              style="width:70px;height:70px;">

              <i class="fa-solid fa-building fs-2"></i>

            </div>

            <h3 class="fw-bold mb-1">
              <%= typeof companyCount !== 'undefined' ? companyCount : '350+' %>
            </h3>

            <p class="text-muted mb-0">
              Empresas
            </p>

          </div>

        </div>

      </div>


      <!-- Estudiantes -->
      <div class="col-6 col-lg-3">

        <div class="card border-0 shadow-sm h-100">

          <div class="card-body text-center p-4">

            <div
              class="bg-warning bg-opacity-10
                     text-warning rounded-circle
                     d-inline-flex align-items-center
                     justify-content-center mb-3"
              style="width:70px;height:70px;">

              <i class="fa-solid fa-user-graduate fs-2"></i>

            </div>

            <h3 class="fw-bold mb-1">
              <%= typeof studentCount !== 'undefined' ? studentCount : '15K+' %>
            </h3>

            <p class="text-muted mb-0">
              Estudiantes
            </p>

          </div>

        </div>

      </div>


      <!-- Universidades -->
      <div class="col-6 col-lg-3">

        <div class="card border-0 shadow-sm h-100">

          <div class="card-body text-center p-4">

            <div
              class="bg-danger bg-opacity-10
                     text-danger rounded-circle
                     d-inline-flex align-items-center
                     justify-content-center mb-3"
              style="width:70px;height:70px;">

              <i class="fa-solid fa-building-columns fs-2"></i>

            </div>

            <h3 class="fw-bold mb-1">
              <%= typeof universityCount !== 'undefined' ? universityCount : '30+' %>
            </h3>

            <p class="text-muted mb-0">
              Universidades
            </p>

          </div>

        </div>

      </div>

    </div>

  </div>

</section>


<!-- =========================================================
     OFERTAS DESTACADAS
========================================================= -->

<section class="bg-light py-5">

  <div class="container">

    <div class="d-flex flex-wrap justify-content-between align-items-end gap-2 mb-4">

      <div>

        <span class="text-success fw-bold text-uppercase">
          Recién publicadas
        </span>

        <h2 class="fw-bold mt-2 mb-0">
          Ofertas destacadas
        </h2>

      </div>

      <a
        href="/convocatorias"
        class="btn btn-outline-success">

        Ver todas
        <i class="fa-solid fa-arrow-right ms-1"></i>

      </a>

    </div>


    <%
      const featuredOffers = typeof offers !== 'undefined' ? offers : [
        { puesto: 'Practicante de Marketing Digital', empresa: 'Retail Perú S.A.', distrito: 'San Isidro', modalidad: 'Híbrido', tipo: 'Preprofesional', icono: 'fa-bullhorn' },
        { puesto: 'Practicante de Desarrollo Web', empresa: 'TechLima Startup', distrito: 'Miraflores', modalidad: 'Remoto', tipo: 'Profesional', icono: 'fa-code' },
        { puesto: 'Practicante de Finanzas', empresa: 'Banco Andino', distrito: 'Santiago de Surco', modalidad: 'Presencial', tipo: 'Preprofesional', icono: 'fa-chart-line' }
      ]
    %>

    <div class="row g-4">

      <% featuredOffers.forEach(offer => { %>

        <div class="col-12 col-md-6 col-lg-4">

          <div class="card border-0 shadow-sm h-100">

            <div class="card-body p-4 d-flex flex-column">

              <div class="d-flex align-items-center mb-3">

                <div
                  class="bg-success bg-opacity-10 text-success rounded-3
                         d-inline-flex align-items-center justify-content-center me-3"
                  style="width:50px;height:50px;">

                  <i class="fa-solid <%= offer.icono %> fs-4"></i>

                </div>

                <div>

                  <h5 class="fw-bold mb-0">
                    <%= offer.puesto %>
                  </h5>

                  <small class="text-muted">
                    <%= offer.empresa %>
                  </small>

                </div>

              </div>

              <div class="d-flex flex-wrap gap-2 mb-4">

                <span class="badge bg-secondary bg-opacity-10 text-dark">
                  <i class="fa-solid fa-location-dot me-1"></i>
                  <%= offer.distrito %>
                </span>

                <span class="badge bg-secondary bg-opacity-10 text-dark">
                  <i class="fa-solid fa-laptop-house me-1"></i>
                  <%= offer.modalidad %>
                </span>

                <span class="badge bg-success">
                  <%= offer.tipo %>
                </span>

              </div>

              <a
                href="/convocatorias"
                class="btn btn-success mt-auto">

                Ver oferta

              </a>

            </div>

          </div>

        </div>

      <% }) %>

    </div>

  </div>

</section>


<!-- =========================================================
     SOBRE LA PLATAFORMA
========================================================= -->

<section
  id="about"
  class="bg-dark text-white py-5">

  <div class="container">

    <div class="row align-items-center g-5">

      <div class="col-lg-6">

        <span class="badge bg-success mb-3">
          SOBRE PRÁCTICALIMA
        </span>

        <h2 class="display-6 fw-bold mb-4">
          Todo lo que necesitas
          para conseguir tu práctica.
        </h2>

        <p class="text-secondary lead">
          PrácticaLima es una bolsa de trabajo creada para que
          estudiantes universitarios encuentren prácticas en
          empresas de Lima de forma rápida y segura.
        </p>

        <p class="text-secondary">
          Las ofertas están organizadas por carrera, distrito,
          modalidad y tipo de práctica, para que solo veas
          lo que de verdad te interesa.
        </p>

        <a
          href="/informacion"
          class="btn btn-success mt-3">

          Cómo funciona

        </a>

      </div>


      <div class="col-lg-6">

        <div class="row g-3">

          <div class="col-6">

            <div class="card bg-secondary bg-opacity-10
                        border-secondary h-100">

              <div class="card-body p-4">

                <i class="fa-solid fa-shield-halved
                          text-success fs-1"></i>

                <h5 class="mt-3 text-white">
                  Empresas verificadas
                </h5>

                <p class="text-secondary small mb-0">
                  Revisamos cada empresa antes de
                  publicar sus ofertas.
                </p>

              </div>

            </div>

          </div>


          <div class="col-6">

            <div class="card bg-secondary bg-opacity-10
                        border-secondary h-100">

              <div class="card-body p-4">

                <i class="fa-solid fa-filter
                          text-success fs-1"></i>

                <h5 class="mt-3 text-white">
                  Filtros
                </h5>

                <p class="text-secondary small mb-0">
                  Busca por carrera, distrito
                  y modalidad.
                </p>

              </div>

            </div>

          </div>


          <div class="col-6">

            <div class="card bg-secondary bg-opacity-10
                        border-secondary h-100">

              <div class="card-body p-4">

                <i class="fa-solid fa-file-lines
                          text-success fs-1"></i>

                <h5 class="mt-3 text-white">
                  CV único
                </h5>

                <p class="text-secondary small mb-0">
                  Sube tu CV una vez y úsalo
                  en todas tus postulaciones.
                </p>

              </div>

            </div>

          </div>


          <div class="col-6">

            <div class="card bg-secondary bg-opacity-10
                        border-secondary h-100">

              <div class="card-body p-4">

                <i class="fa-solid fa-bell
                          text-success fs-1"></i>

                <h5 class="mt-3 text-white">
                  Alertas
                </h5>

                <p class="text-secondary small mb-0">
                  Recibe avisos de nuevas
                  ofertas para tu carrera.
                </p>

              </div>

            </div>

          </div>

        </div>

      </div>

    </div>

  </div>

</section>


<!-- =========================================================
     CTA FINAL
========================================================= -->

<section class="py-5">

  <div class="container">

    <div
      class="bg-success rounded-4 p-5 text-center text-white">

      <i class="fa-solid fa-user-graduate fs-1"></i>

      <h2 class="fw-bold mt-3">
        ¿Listo para tu primera práctica?
      </h2>

      <p class="lead mb-4">
        Crea tu cuenta gratis y empieza a postular hoy mismo.
      </p>

      <div class="d-flex flex-wrap justify-content-center gap-2">

        <a
          href="/login"
          class="btn btn-light btn-lg px-5">

          <i class="fa-solid fa-user-plus me-2"></i>
          Crear cuenta

        </a>

        <a
          href="/convocatorias"
          class="btn btn-outline-light btn-lg px-5">

          Ver ofertas

        </a>

      </div>

    </div>

  </div>

</section>
